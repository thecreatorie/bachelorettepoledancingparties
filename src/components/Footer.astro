---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="grid">
      <div>
        <a href="/" class="logo">Bachelorette Pole Dancing Parties</a>
        <p class="tagline">
          Pole dancing bachelorette parties in Las Vegas — private parties at
          <a href="https://www.polefitnessstudio.com/" rel="noopener">Pole Fitness Studio</a>,
          2 minutes west of the Strip. Open for parties 24/7.
        </p>
        <p class="contact-line">
          <a href="tel:+17028787653">702-878-POLE (7653)</a><br />
          4265 S. Arville Street, Suite A<br />
          Las Vegas, Nevada 89103
        </p>
      </div>
      <nav aria-label="Footer">
        <h2>Site</h2>
        <ul>
          <li><a href="/party-package">Party Packages</a></li>
          <li><a href="/reviews">Reviews</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="https://www.officiallyfawnia.com/videos" rel="noopener">Merch</a></li>
        </ul>
      </nav>
      <nav aria-label="More links">
        <h2>Follow &amp; Book</h2>
        <ul>
          <li><a href="https://www.polefitnessstudio.com/parties" rel="noopener">Book Online</a></li>
          <li><a href="https://www.polefitnessstudio.com/" rel="noopener">Pole Fitness Studio</a></li>
          <li><a href="https://www.facebook.com/bachelorettepole" rel="noopener">BPDP Facebook</a></li>
          <li><a href="https://www.facebook.com/PoleFitnessStudioLV" rel="noopener">PFS Facebook</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
        </ul>
      </nav>
    </div>
    <p class="copyright">© {year} Bachelorette Pole Dancing Parties · Pole Fitness Studio, Las Vegas. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-12) var(--space-6);
    margin-top: var(--space-section);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .logo {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    text-decoration: none;
  }

  .tagline {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 42ch;
  }

  .tagline a {
    color: var(--color-text-muted);
  }

  .contact-line {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .contact-line a {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
    text-decoration: none;
  }

  .contact-line a:hover {
    text-decoration: underline;
  }

  h2 {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4) 0;
  }

  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .copyright {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
  }
</style>

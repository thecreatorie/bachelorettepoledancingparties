---
import Nav from './Nav.astro';
import MobileNav from './MobileNav.astro';
---

<header class="site-header">
  <div class="container">
    <a href="/" class="logo" aria-label="Home">
      <span class="logo-text">
        <span class="logo-script">Bachelorette</span>
        <span class="logo-sub">Pole Dancing Parties</span>
      </span>
    </a>
    <Nav />
    <MobileNav />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 70;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .site-header > .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 64px;
    padding-block: var(--space-3);
    transition: min-height var(--duration-normal) var(--ease-out),
                padding var(--duration-normal) var(--ease-out);
  }

  /* Shrinks after 40px scroll — .is-scrolled toggled by Motion.astro */
  .site-header.is-scrolled {
    box-shadow: 0 6px 24px rgb(214 51 108 / 0.12);
  }

  .site-header.is-scrolled > .container {
    min-height: 52px;
    padding-block: var(--space-1);
  }

  .logo {
    text-decoration: none;
    color: var(--color-text);
    line-height: 1;
  }
  .logo-text { display: block; }
  .logo-script {
    display: block;
    font-family: var(--font-script);
    font-size: clamp(1.5rem, 6vw, 1.9rem);
    line-height: 0.95;
    color: var(--color-primary);
  }
  .logo-sub {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(0.56rem, 2.5vw, 0.7rem);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-top: 2px;
  }
</style>

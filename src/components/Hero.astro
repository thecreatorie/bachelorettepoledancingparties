---
import { Image } from 'astro:assets';
import Button from './Button.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  polaroidImage?: ImageMetadata;
  polaroidAlt?: string;
  scriptWord?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  ctaLabel,
  ctaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  image,
  imageAlt,
  polaroidImage,
  polaroidAlt,
  scriptWord,
} = Astro.props;

const LEAD = /^(Welcome to|Meet|Discover)\s+/i;
const _m = String(title).match(LEAD);
const leadIn = _m ? _m[0].trim() : null;
const mainTitle = _m ? String(title).slice(_m[0].length) : title;
---

<section class="hero">
  <div class="container">
    <div class="copy">
      {eyebrow && !leadIn && <p class="eyebrow">{eyebrow}</p>}
      <h1>
        {leadIn && <span class="lead-in">{leadIn}</span>}
        {mainTitle}
        {scriptWord && <span class="hero-script script">{scriptWord}</span>}
      </h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      {(ctaLabel || secondaryCtaLabel) && (
        <div class="ctas">
          {ctaLabel && ctaHref && <Button href={ctaHref} variant="primary" size="lg">{ctaLabel}</Button>}
          {secondaryCtaLabel && secondaryCtaHref && <Button href={secondaryCtaHref} variant="ghost" size="lg">{secondaryCtaLabel}</Button>}
        </div>
      )}
    </div>
    {image && (
      <div class="media-cluster">
        <div class="blob-frame">
          <Image
            src={image}
            alt={imageAlt ?? ''}
            widths={[480, 768, 1280, 1920]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        {scriptWord && <span class="media-script script" aria-hidden="true">{scriptWord}</span>}

        {polaroidImage && (
          <figure class="polaroid">
            <Image
              src={polaroidImage}
              alt={polaroidAlt ?? ''}
              widths={[240, 480]}
              sizes="220px"
              loading="eager"
            />
          </figure>
        )}

        <!-- Floating doodles (decorative) -->
        <svg class="doodle doodle-heart" width="44" height="40" viewBox="0 0 44 40" fill="none" aria-hidden="true">
          <path d="M22 38C10 28 2 20.5 2 12.5 2 6.5 6.8 2 12.5 2 16.4 2 20 4.2 22 7.5 24 4.2 27.6 2 31.5 2 37.2 2 42 6.5 42 12.5c0 8-8 15.5-20 25.5Z" fill="var(--color-primary)"/>
        </svg>
        <svg class="doodle doodle-glass" width="34" height="56" viewBox="0 0 34 56" fill="none" aria-hidden="true">
          <path d="M4 2h26l-3 20c-.8 5.5-4.9 9.4-10 9.4S7.8 27.5 7 22L4 2Z" fill="var(--color-accent)"/>
          <path d="M17 31.4V50M8 54h18M8 54c0-2.2 4-4 9-4s9 1.8 9 4" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round"/>
          <circle cx="12" cy="10" r="2" fill="#fff" opacity="0.7"/>
          <circle cx="20" cy="15" r="1.5" fill="#fff" opacity="0.7"/>
        </svg>
        <svg class="doodle doodle-star" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M20 1c1.6 9.8 8.2 16.4 18 18-9.8 1.6-16.4 8.2-18 18-1.6-9.8-8.2-16.4-18-18C11.8 17.4 18.4 10.8 20 1Z" fill="var(--color-secondary)"/>
        </svg>
        <svg class="doodle doodle-confetti" width="70" height="46" viewBox="0 0 70 46" fill="none" aria-hidden="true">
          <circle cx="6" cy="8" r="4" fill="var(--color-accent)"/>
          <circle cx="34" cy="4" r="3" fill="var(--color-primary)"/>
          <circle cx="60" cy="12" r="4.5" fill="var(--color-secondary)"/>
          <circle cx="18" cy="34" r="3.5" fill="var(--color-secondary)"/>
          <circle cx="48" cy="38" r="3" fill="var(--color-primary)"/>
          <circle cx="66" cy="30" r="2.5" fill="var(--color-accent)"/>
        </svg>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-section);
    overflow-x: clip;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero .container {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .eyebrow {
    margin: 0 0 var(--space-3) 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-secondary);
  }

  .lead-in {
    display: block;
    font-size: 0.34em;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 0.5em;
    line-height: 1.2;
  }
  h1 {
    position: relative;
    margin-bottom: var(--space-4);
  }

  .hero-script {
    position: absolute;
    top: -0.62em;
    right: 0;
    display: inline-block;
    transform: rotate(-4deg);
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.2rem);
    line-height: 1;
    white-space: nowrap;
    color: var(--color-primary);
    text-shadow: 0 2px 0 var(--color-bg);
    pointer-events: none;
  }

  .subtitle {
    font-size: var(--fs-lg);
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-block: var(--space-4);
  }

  .ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  /* --- Layered media cluster --- */
  .media-cluster {
    position: relative;
    margin-inline: var(--space-6);
  }

  .blob-frame {
    overflow: hidden;
    border-radius: 48% 52% 46% 54% / 42% 44% 56% 58%;
    box-shadow: 0 24px 60px rgb(214 51 108 / 0.22);
    aspect-ratio: 1 / 1.05;
  }

  .blob-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .polaroid {
    position: absolute;
    bottom: -28px;
    left: -30px;
    width: clamp(140px, 22vw, 220px);
    margin: 0;
    padding: 10px 10px 30px;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 14px 36px rgb(43 22 34 / 0.25);
    transform: rotate(-5deg);
  }

  .polaroid :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .doodle-heart { top: -26px; left: 6%; }
  .doodle-glass { top: 14%; right: -20px; animation-delay: -2.5s; }
  .doodle-star { bottom: 16%; right: -8px; animation-delay: -4s; }
  .doodle-confetti { top: -14px; right: 20%; animation-delay: -1.2s; }

  /* Script word duplicated over the photo — mobile only (desktop uses .hero-script on the h1) */
  .media-script {
    display: none;
    position: absolute;
    bottom: 18px;
    right: 18px;
    z-index: 2;
    transform: rotate(-4deg);
    font-size: 2.4rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-primary);
    text-shadow:
      0 0 12px rgb(255 250 252 / 0.95),
      0 2px 4px rgb(255 250 252 / 0.9);
    pointer-events: none;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .media-cluster { margin-inline: var(--space-8) var(--space-4); }
    .doodle-glass { right: 0; }
  }

  /* --- Mobile (<768px): simplified composition, IMAGE FIRST --- */
  @media (max-width: 767px) {
    .hero .container { gap: var(--space-8); }

    /* Collage above headline/copy/CTAs */
    .media-cluster {
      order: -1;
      margin-inline: 0;
      width: 100%;
    }

    /* Main photo alone: fixed 4/5 aspect, arch-top mask, full width */
    .blob-frame {
      aspect-ratio: 4 / 5;
      width: 100%;
      border-radius: 50% 50% 28px 28px / 22% 22% 28px 28px;
    }

    /* The layered extras don't hold up at 390px — keep photo + script + one doodle */
    .polaroid,
    .doodle-glass,
    .doodle-star,
    .doodle-confetti { display: none; }

    .doodle-heart {
      top: 12px;
      left: 12px;
      width: 34px;
      height: auto;
    }

    .media-script { display: inline-block; }
    .hero-script { display: none; }
  }

  /* HERO MOBILE TUNING */
  @media (max-width: 767px) {
    .media-cluster .main-photo,
    .media-cluster img { aspect-ratio: 1 / 1; }
    h1 { font-size: clamp(2.05rem, 1.1rem + 3.4vw, 2.5rem); }
    .lead-in { font-size: 0.42em; margin-bottom: 0.35em; }
    .subtitle { font-size: 1.0625rem; }
  }
  /* Script word over the photo — guarantee legibility on any image */
  .media-script,
  .media-cluster .script {
    text-shadow:
      0 2px 10px rgba(20, 6, 14, 0.85),
      0 0 26px rgba(20, 6, 14, 0.7);
    color: #ffffff;
  }
</style>

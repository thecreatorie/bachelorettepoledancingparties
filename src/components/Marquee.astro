---
export interface Props {
  items?: string[];
}

const {
  items = [
    'Bride to Be',
    'Las Vegas',
    'Pole Party',
    'Champagne',
    'Girls Night',
    'Bachelorette',
    'Dance',
    'Celebrate',
  ],
} = Astro.props;
---

<div class="marquee">
  <div class="marquee-track">
    <span class="marquee-row">
      {items.map((item) => (
        <span class="marquee-item">{item} <span class="sep" aria-hidden="true">✦</span></span>
      ))}
    </span>
    <span class="marquee-row" aria-hidden="true">
      {items.map((item) => (
        <span class="marquee-item">{item} <span class="sep">✦</span></span>
      ))}
    </span>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    background: linear-gradient(120deg, var(--color-primary), var(--color-secondary));
    color: #ffffff;
    padding-block: var(--space-4);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
  }

  .marquee-row {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-right: var(--space-8);
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-lg);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
  }

  .sep {
    color: var(--color-accent);
    letter-spacing: 0;
  }

  @keyframes marquee-scroll {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>

---
const items = [
  { label: 'Home', href: '/' },
  { label: 'Party Packages', href: '/party-package' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'Book Now', href: 'https://www.polefitnessstudio.com/parties' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  !href.startsWith('http') && (pathname === href || (href !== '/' && pathname.startsWith(href)));
---

<div class="mobile-nav-wrap">
  <button id="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Open menu">
    <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
    </svg>
  </button>

  <div id="mobile-nav-drawer" class="drawer" hidden>
    <nav aria-label="Mobile primary">
      <ul>
        {items.map(item => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</div>

<style>
  .mobile-nav-wrap button {
    background: transparent;
    border: none;
    padding: var(--space-2);
    cursor: pointer;
    color: var(--color-text);
    border-radius: var(--radius-md);
    /* 44x44 minimum touch target */
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-nav-wrap button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (min-width: 768px) {
    .mobile-nav-wrap { display: none; }
  }

  .drawer {
    /* Full-screen fixed panel. Explicit LITERAL background color — never a
       var/color-mix/backdrop-filter, so the menu can never render translucent
       even if custom properties fail to resolve. Header (z 70) stays above so
       the hamburger remains clickable; panel covers the whole viewport
       (inset: 0) with top padding clearing the header at its TALLEST state
       (header shrinks on scroll, so 64px + border is the max to clear). */
    position: fixed;
    inset: 0;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: #fffafc;
    background-clip: padding-box;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    padding: calc(72px + var(--space-4)) var(--space-5) var(--space-8);
    z-index: 60;
    overflow-y: auto;
  }

  .drawer[hidden] { display: none; }

  .drawer nav {
    /* Subtle brand border marking the top of the menu panel */
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }

  .drawer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .drawer a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--fs-lg);
    font-weight: var(--fw-medium);
    border-radius: var(--radius-md);
    border-left: 3px solid transparent;
  }

  .drawer a:hover {
    background: var(--color-surface);
  }

  .drawer a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .drawer a[aria-current='page'] {
    color: var(--color-text);
    border-left-color: var(--color-primary);
    background: var(--color-surface);
    font-weight: var(--fw-semibold);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  /* PORTAL: move the drawer to <body> so no ancestor filter/transform can
     become its containing block and trap inset:0 inside the header. */
  if (drawer && drawer.parentElement !== document.body) document.body.appendChild(drawer);

  if (toggle && drawer) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        drawer.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
        const first = drawer.querySelector('a');
        (first as HTMLElement | null)?.focus();
      } else {
        drawer.setAttribute('hidden', '');
        document.body.style.overflow = '';
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close when a menu link is tapped
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
